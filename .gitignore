# Confidential candidate input documents
inputs/*
!inputs/.gitkeep

# Generated pipeline runs and artifacts
runs/*
!runs/.gitkeep

# Environment variables and secrets
.env

# Python virtual environment
env/
.venv/
venv/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs and generated media
*.log
*.mp3
*.wav
*.mp4

# VS Code and operating system files
.vscode/
.DS_Store
Thumbs.db
``